# rate-guard — configuration example.
# Copy to `.env` and adjust to your AI provider.

# === AI provider ===
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=sk-...

# === Plan limits (announced by provider) ===
# The queue applies `SAFETY_MARGIN` over these values.
RPM_LIMIT=500
TPM_LIMIT=90000

# === Queue ===
QUEUE_CONCURRENCY=1
# AIMD — drops/rises dynamically on 429/success. Default OFF (keeps it fixed).
ADAPTIVE_CONCURRENCY=false
MAX_CONCURRENCY=8
MIN_CONCURRENCY=1

# === Safety margin ===
# Operating at 80% of the ceiling absorbs provider peak windows. Range (0, 1].
SAFETY_MARGIN=0.8

# === Retries (exponential backoff + jitter) ===
MAX_RETRIES=8
BASE_BACKOFF_MS=1000
MAX_BACKOFF_MS=60000

# === Automatic pause on Retry-After ===
# Ceiling for auto-pause time (protection against malformed header).
MAX_AUTO_PAUSE_MS=60000
