# rate-guard — exemplo de configuração.
# Copie para `.env` e ajuste conforme seu provedor de IA.

# === Provedor de IA ===
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=sk-...

# === Limites do seu plano (announce pelo provedor) ===
# A fila aplica `SAFETY_MARGIN` sobre esses valores.
RPM_LIMIT=500
TPM_LIMIT=90000

# === Fila ===
QUEUE_CONCURRENCY=1
# AIMD — cai/sob dinamicamente em 429/sucesso. Default OFF (mantém fixa).
ADAPTIVE_CONCURRENCY=false
MAX_CONCURRENCY=8
MIN_CONCURRENCY=1

# === Margem de segurança ===
# Operar em 80% do teto absorve janelas de pico do provedor. Range (0, 1].
SAFETY_MARGIN=0.8

# === Retentativas (backoff exponencial + jitter) ===
MAX_RETRIES=8
BASE_BACKOFF_MS=1000
MAX_BACKOFF_MS=60000

# === Pausa automática em Retry-After ===
# Teto do tempo de auto-pause (proteção contra header mal-formado).
MAX_AUTO_PAUSE_MS=60000
